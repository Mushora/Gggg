rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Check if user is signed in through Firebase Auth
    function isSignedIn() {
      return request.auth != null;
    }

    // Categories: Publicly readable by all visitors. Modifiable by administrator or authenticated sessions.
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isValidId(categoryId);
    }

    // Products: Publicly readable by all visitors without login. Modifiable by administrator.
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isValidId(productId);
    }

    // Admin Settings: Configuration and credential records. Modifiable by administrator.
    match /adminSettings/{settingId} {
      allow read, write: if isValidId(settingId);
    }
  }
}
